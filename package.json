{
  "name": "mikecebul-website",
  "version": "0.0.1",
  "description": "Mike Cebul - Software Engineering Consultant and Full-Stack Developer website.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "vite dev --port 3000",
    "dev:prod": "pnpm build && pnpm start",
    "email:dev": "CHOKIDAR_USEPOLLING=true email dev -d ./src/emails -p 3025",
    "generate:importmap": "payload generate:importmap",
    "generate:types": "payload generate:types",
    "ii": "cross-env NODE_OPTIONS=--no-deprecation pnpm install",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation eslint .",
    "lint:fix": "cross-env NODE_OPTIONS=--no-deprecation eslint . --fix",
    "typecheck": "tsc --noEmit",
    "migrate:create": "cross-env payload migrate:create",
    "payload": "payload",
    "reinstall": "cross-env NODE_OPTIONS=--no-deprecation rm -rf node_modules && rm pnpm-lock.yaml && pnpm install",
    "start": "node .output/server/index.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview",
    "generate-routes": "tsr generate",
    "backup": "sh scripts/backup-sqlite.sh",
    "test:database": "payload run scripts/verify-sqlite.ts"
  },
