# Used to encrypt JWT tokens
PAYLOAD_SECRET=payload-secret-here
PREVIEW_SECRET=preview-secret-here

# Public build settings (existing NEXT_PUBLIC names are also supported)
# VITE_SERVER_URL=http://localhost:3000
# VITE_SENTRY_DSN=
# VITE_IS_LIVE=false

# Used to format links and URLs
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Allow robots to index the site (optional)
NEXT_PUBLIC_IS_LIVE=false

# Google Maps
GOOGLE_MAPS_API_KEY=google-maps-api-key

# Resend Email
RESEND_API_KEY=
CONTACT_TO_EMAIL=
EMAIL_HOST=localhost
EMAIL_PORT=1025
EMAIL_USER=dev
EMAIL_PASSWORD=password

# SQLite (Dokploy: file:/app/data/payload.db on a named volume)
DATABASE_URI=file:./data/payload.db

# S3
S3_ENABLED=false
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
S3_ENDPOINT=
S3_BUCKET=
NEXT_PUBLIC_S3_HOSTNAME=
NEXT_PUBLIC_UPLOAD_PREFIX=dev

# Unsplash API
UNSPLASH_ACCESS_KEY=
UNSPLASH_URL=https://api.unsplash.com/photos/

# Sentry
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_SUPPRESS_GLOBAL_ERROR_HANDLER_FILE_WARNING=1

# Umami Analytics
UMAMI_WEBSITE_ID=
UMAMI_API_CLIENT_ENDPOINT=
UMAMI_API_CLIENT_USER_ID=
UMAMI_API_CLIENT_SECRET=
UMAMI_API_KEY=
