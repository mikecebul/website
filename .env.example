# Used to encrypt JWT tokens
PAYLOAD_SECRET=payload-secret-here
PREVIEW_SECRET=preview-secret-here

# Optional Vite browser build overrides (normally mapped from SERVER_URL and SENTRY_DSN)
# VITE_SERVER_URL=http://localhost:3000
# VITE_SENTRY_DSN=

# Used to format links and URLs
SERVER_URL=http://localhost:3000

# Allow robots to index the site (optional)
IS_LIVE=false

# Google Maps
GOOGLE_MAPS_API_KEY=google-maps-api-key

# Resend Email
RESEND_API_KEY=
CONTACT_TO_EMAIL=
EMAIL_HOST=localhost
EMAIL_PORT=1025
EMAIL_USER=dev
EMAIL_PASSWORD=password

# SQLite (Dokploy: file:/app/data/payload.db on a named volume)
DATABASE_URI=file:./data/payload.db

# Development only: set false to disable sample blogs, admin reset, and auto-login.
# DEV_SEED=false

# S3
S3_ENABLED=false
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
S3_ENDPOINT=
S3_BUCKET=
S3_HOSTNAME=
UPLOAD_PREFIX=dev

# Live SQLite backups reuse the S3 settings above. Use an existing PRIVATE bucket.
# BACKUP_DESTINATION=s3://your-private-backup-bucket/mikecebul/website/sqlite
# Optional pair if the media key cannot access the private backup bucket:
# BACKUP_S3_ACCESS_KEY_ID=
# BACKUP_S3_SECRET_ACCESS_KEY=

# Unsplash API
UNSPLASH_ACCESS_KEY=
UNSPLASH_URL=https://api.unsplash.com/photos/

# Sentry
# Used for the browser build, server SDK, and browser tunnel. Supply at build AND runtime.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
# Build-only source-map upload configuration; never expose the auth token to the browser.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_URL=https://sentry.io
SENTRY_AUTH_TOKEN=

# Umami Analytics
UMAMI_WEBSITE_ID=
UMAMI_API_CLIENT_ENDPOINT=
UMAMI_API_CLIENT_USER_ID=
UMAMI_API_CLIENT_SECRET=
UMAMI_API_KEY=
